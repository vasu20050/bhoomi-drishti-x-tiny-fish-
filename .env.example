# Bhoomi Drishti x TinyFish Environment Configuration
# Get your TinyFish API Key from: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Optional: AI Studio Gemini API Key for enhanced LLM synthesis
# Get yours from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: OpenAI API Key
OPENAI_API_KEY=

# Agent Mode: AUTO (uses live API if key is set, falls back to local simulation),
# LIVE (requires valid API key), or SIMULATION (instant offline demo)
TINYFISH_AGENT_MODE=AUTO

# Server Port Configuration
PORT=8000
HOST=0.0.0.0
